#!/bin/sh
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI1: BMI088. Add -R once the mounting orientation is known.
bmi088 -A -s -b 1 start
bmi088 -G -s -b 1 start

# Internal SPI2: BMI270, SPL06
bmi270 -s -b 2 start
spl06 -s -b 2 start

# External I2C1: compass in the GNSS module
qmc5883l -X -a 0x0D start
